{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "scripts/adapter-templates"],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@cyberdream/site-config": ["src/config/index.ts"],
      "@cyberdream/site-config/*": ["src/config/*"],
      "@cyberdream/site-i18n": ["src/i18n/config.ts"],
      "@cyberdream/site-i18n/*": ["src/i18n/*"],
      "@cyberdream/theme-default-i18n": [
        "packages/theme/src/i18n/messages.ts",
        "node_modules/@cyberdream/astro-theme/src/i18n/messages.ts"
      ]
    }
  }
}
