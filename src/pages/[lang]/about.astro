---
import type { GetStaticPaths } from 'astro';
import AboutPage from '@cyberdream/astro-theme/layouts/AboutPage.astro';
import { getAboutConfig } from '../../config/about';
import { THEME } from '../../config/theme';
import { ENABLED_LOCALES, type Locale, DEFAULT_LOCALE, isLocale } from '../../i18n/config';

export const getStaticPaths = (() => {
  if (!THEME.ABOUT_PAGE_ENABLED) return [];
  return ENABLED_LOCALES.map((locale) => ({ params: { lang: locale } }));
}) satisfies GetStaticPaths;

const raw = Astro.params.lang ?? DEFAULT_LOCALE;
const locale: Locale = isLocale(raw) ? raw : DEFAULT_LOCALE;
---

<AboutPage locale={locale} about={getAboutConfig(locale)} />
