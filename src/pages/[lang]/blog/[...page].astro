---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogArchive from '@cyberdream/astro-theme/layouts/BlogArchive.astro';
import { ENABLED_LOCALES, type Locale, DEFAULT_LOCALE, isLocale } from '../../../i18n/config';
import { BLOG_PAGE_SIZE, postsForLocale } from '../../../i18n/posts';

export const getStaticPaths = (async () => {
  const all = await getCollection('blog');
  return ENABLED_LOCALES.flatMap((locale) => {
    const posts = postsForLocale(all, locale);
    // max(1, ...) so a locale with no translations yet still renders page 1
    // with the "no posts" message rather than 404ing.
    const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));

    return Array.from({ length: totalPages }, (_, i) => {
      const currentPage = i + 1;
      return {
        params: currentPage === 1 ? { lang: locale } : { lang: locale, page: String(currentPage) },
        props: {
          locale,
          posts: posts.slice(i * BLOG_PAGE_SIZE, i * BLOG_PAGE_SIZE + BLOG_PAGE_SIZE),
          currentPage,
          totalPages,
        },
      };
    });
  });
}) satisfies GetStaticPaths;

const { posts, currentPage, totalPages } = Astro.props;
const raw = Astro.props.locale ?? Astro.params.lang ?? DEFAULT_LOCALE;
const locale: Locale = isLocale(raw) ? raw : DEFAULT_LOCALE;
---

<BlogArchive
  locale={locale}
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
/>
