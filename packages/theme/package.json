{
  "name": "@cyberdream/astro-theme",
  "version": "0.2.11",
  "type": "module",
  "description": "Cyberdream theme for Astro, built on CYBERCORE CSS",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "cyberpunk",
    "cybercore"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src/index.ts",
    "src/content-schema.ts",
    "src/config",
    "src/components",
    "src/layouts",
    "src/scaffold",
    "src/i18n",
    "src/styles",
    "src/utils",
    "src/assets/theme",
    "src/cli-new-post.mjs",
    "src/cli-new-page.mjs"
  ],
  "bin": {
    "cyberdream-new-post": "src/cli-new-post.mjs",
    "cyberdream-new-page": "src/cli-new-page.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./i18n/*": "./src/i18n/*",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./src/assets/*",
    "./utils/merge": "./src/utils/merge.ts",
    "./utils/number": "./src/utils/number.ts",
    "./utils/pagination": "./src/utils/pagination.ts",
    "./utils/*": "./src/utils/*",
    "./content-schema": "./src/content-schema.ts"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "cybercore-css": "^0.3.0"
  }
}
