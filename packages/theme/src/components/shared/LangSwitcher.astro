---
/**
 * Locale switcher, on CyberCore's .cyber-select.
 *
 * Kept from the previous rebuild: no inline handler (so the site can set a CSP
 * without 'unsafe-inline'), the visible <label> is the accessible name rather
 * than a duplicate aria-label, and a <noscript> list keeps it usable with JS off.
 */
import type { Locale } from '@cyberdream/site-i18n/config';

interface LocaleOption {
  locale: Locale;
  label: string;
  href: string;
}

interface Props {
  label: string;
  currentLocale: Locale;
  options: LocaleOption[];
}

const { label, currentLocale, options } = Astro.props as Props;
---

<div class="cd-lang">
  <label class="cd-lang__label" for="cd-lang-select">{label}</label>
  <select id="cd-lang-select" class="cyber-select" data-lang-select>
    {
      options.map((option) => (
        <option value={option.href} data-locale={option.locale} selected={option.locale === currentLocale}>
          {option.label}
        </option>
      ))
    }
  </select>
  <noscript>
    <ul class="cd-lang__fallback">
      {
        options.map((option) => (
          <li>
            <a href={option.href} hreflang={option.locale}>
              {option.label}
            </a>
          </li>
        ))
      }
    </ul>
  </noscript>
</div>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-lang-select]').forEach((select) => {
    select.addEventListener('change', () => {
      if (!select.value) return;

      /*
        Remember the choice so the `/` language dispatcher stops guessing for
        this visitor. Picking a language explicitly has to outrank whatever the
        browser reports, or someone reading in their second language gets bounced
        back on every visit to the root.
      */
      const locale = select.selectedOptions[0]?.dataset.locale;
      if (locale) {
        try {
          window.localStorage.setItem('cd:locale', locale);
        } catch {
          // Private mode / storage disabled. Navigation below still works.
        }
      }

      window.location.href = select.value;
    });
  });
</script>
