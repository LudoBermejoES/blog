---
/**
 * Post card for the home page and blog archive, on CyberCore's .cyber-card.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { type Locale, blogIdToSlugAnyLocale, localePath } from '@cyberdream/site-i18n/config';
import { countText, deriveMetrics } from '../utils/metrics';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
  /** Frontmatter override. Left out, the card derives it from the body. */
  readMinutes?: number;
  readLabel: string;
  /** Cards near the top of the first screen shouldn't be lazy-loaded. */
  eager?: boolean;
}

const { post, locale, readMinutes, readLabel, eager = false } = Astro.props as Props;
const href = localePath(locale, `/blog/${blogIdToSlugAnyLocale(post.id)}/`);
const { title, description, pubDate, heroImage, heroImageAlt, tags } = post.data;

/*
  Derived here rather than plumbed down from the layouts. `readMinutes` is an
  optional frontmatter field that in practice nobody fills in, so every caller
  passing `post.data.readMinutes` was passing undefined and the card silently
  showed a date and nothing else. Deriving from the body makes the read time
  appear by default and leaves the frontmatter as a deliberate override.
*/
const resolvedReadMinutes =
  readMinutes ?? (post.body ? deriveMetrics(countText(post.body)).readMinutes : undefined);
---

<li class="cyber-card cyber-card--interactive cd-card">
  {
    heroImage && (
      <a class="cd-card__media" href={href} tabindex="-1" aria-hidden="true">
        {/*
          fit="cover" so a cover whose aspect ratio isn't 16:9 gets cropped
          rather than squashed. Without it Astro resizes to exactly 640x360,
          which visibly distorts the 2:1 images in
          src/assets/blog/default-covers/.
        */}
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          width={640}
          height={360}
          fit="cover"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    )
  }

  <p class="cd-meta">
    <FormattedDate date={pubDate} locale={locale} />
    {resolvedReadMinutes !== undefined && <span>~{resolvedReadMinutes} {readLabel}</span>}
  </p>

  <h3 class="cd-card__title"><a href={href}>{title}</a></h3>
  <p class="cd-card__excerpt">{description}</p>

  {
    tags && tags.length > 0 && (
      <p class="cd-meta">
        {tags.slice(0, 3).map((tag) => (
          <span class="cyber-badge">{tag}</span>
        ))}
      </p>
    )
  }
</li>
