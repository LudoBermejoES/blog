---
/**
 * Blog post layout.
 *
 * The old version carried a fixed "monitor" widget playing film footage, three
 * canvas effects and a read-progress bar, across ~400 lines. This is a reading
 * surface: a terminal-styled meta block, the hero, the prose, related posts.
 * No ambient animation behind body text.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CyberdreamShell from './CyberdreamShell.astro';
import Giscus from '../components/Giscus.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_AUTHOR } from '@cyberdream/site-config/site';
import { THEME } from '@cyberdream/site-config/theme';
import {
  DEFAULT_LOCALE,
  type Locale,
  isLocale,
  localePath,
} from '@cyberdream/site-i18n/config';
import { getMessages } from '@cyberdream/site-i18n/messages';

type Props = CollectionEntry<'blog'>['data'] & {
  locale?: string;
  related?: CollectionEntry<'blog'>[];
  localeHrefs?: Partial<Record<Locale, string>>;
  readMinutes?: number;
  wordCount?: number;
};

const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  readMinutes,
  wordCount,
  author,
  tags,
  locale = DEFAULT_LOCALE,
  related = [],
  localeHrefs,
} = Astro.props;

const resolvedLocale: Locale = isLocale(locale) ? locale : DEFAULT_LOCALE;
const messages = getMessages(resolvedLocale);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const blogHref = localePath(resolvedLocale, '/blog/');

const comments = THEME.COMMENTS;
const commentTerm = comments.TERM.trim();
const commentNumber = comments.NUMBER.trim();
const hasValidCommentNumber =
  /^[1-9]\d*$/.test(commentNumber) && Number.isSafeInteger(Number(commentNumber));
const hasMappingParam =
  comments.MAPPING === 'specific'
    ? Boolean(commentTerm)
    : comments.MAPPING === 'number'
      ? hasValidCommentNumber
      : true;
const hasCommentsConfig = Boolean(
  comments.ENABLED &&
    comments.REPO &&
    comments.REPO_ID &&
    comments.CATEGORY &&
    comments.CATEGORY_ID &&
    hasMappingParam
);
---

<CyberdreamShell
  locale={resolvedLocale}
  title={title}
  description={description}
  image={heroImage}
  imageAlt={heroImageAlt}
  pageType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author ?? SITE_AUTHOR}
  tags={tags}
  localeHrefs={localeHrefs}
  bodyClass="cd-page-post"
>
  <article class="cd-article">
    <header class="cd-post-header">
      {/*
        Terminal-styled meta block. Every text run stays on one line: Astro 7's
        compressHTML: 'jsx' default drops whitespace-only line breaks between
        expressions, which silently joined these values together.
      */}
      <div class="cyber-terminal cyber-terminal--sm">
        <div class="cyber-terminal__body">
          <p class="cd-meta">
            <span>$ {messages.blog.metaPublished} {iso(pubDate)}</span>
            {updatedDate && <span>| {messages.blog.metaUpdated} {iso(updatedDate)}</span>}
            {readMinutes !== undefined && <span>| ~{readMinutes} {messages.blog.metaReadMinutes}</span>}
            {wordCount !== undefined && <span>| {wordCount} {messages.blog.statsWords}</span>}
          </p>
        </div>
      </div>

      <h1 class="cd-post-header__title">{title}</h1>
      {subtitle && <p class="cd-hero__lede">{subtitle}</p>}

      {
        tags && tags.length > 0 && (
          <p class="cd-meta">
            {tags.map((tag) => (
              <span class="cyber-badge cyber-badge--filled">{tag}</span>
            ))}
          </p>
        )
      }
    </header>

    {
      heroImage && (
        <figure class="cd-post-hero">
          <Image
            src={heroImage}
            alt={heroImageAlt ?? ''}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="cd-prose">
      <slot />
    </div>

    <footer style="margin-top: var(--space-xl);">
      <a class="cyber-btn cyber-btn--sm" href={blogHref}>{messages.blog.backToBlog}</a>
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="cd-article" aria-labelledby="cd-related" style="margin-top: var(--space-2xl);">
        <h2 id="cd-related" class="cyber-heading">
          {messages.blog.related}
        </h2>
        <ul class="cd-grid">
          {related.map((post) => (
            <PostCard
              post={post}
              locale={resolvedLocale}
              readMinutes={post.data.readMinutes}
              readLabel={messages.blog.metaReadMinutes}
            />
          ))}
        </ul>
      </section>
    )
  }

  {
    hasCommentsConfig && (
      <section class="cd-article" aria-labelledby="cd-comments" style="margin-top: var(--space-2xl);">
        <h2 id="cd-comments" class="cyber-heading">
          {messages.blog.comments}
        </h2>
        <Giscus comments={comments} resolvedLocale={resolvedLocale} />
      </section>
    )
  }
</CyberdreamShell>
