---
/**
 * About page.
 *
 * Style is unchanged from the config-driven version — terminal meta line,
 * numbered section headings, closing pull-quote. What changed is where the
 * content comes from: an `about` content-collection entry per locale, authored
 * as Markdown, instead of a nested object in src/site.config.ts.
 *
 * The section numbers (01 /, 02 / …) are a CSS counter in cyberdream.css, not
 * literal text. That is deliberate: the author writes `## Quién soy` and the
 * numbering follows, so inserting a section does not mean renumbering it in six
 * languages — and it was renumbering by hand that produced the 01, 02, 04, 03
 * bug in the previous version.
 */
import CyberdreamShell from './CyberdreamShell.astro';
import { SITE_AUTHOR } from '@cyberdream/site-config/site';
import {
  type Locale,
  DEFAULT_LOCALE,
  ENABLED_LOCALE_LABELS,
  isLocale,
} from '@cyberdream/site-i18n/config';
import { getMessages } from '@cyberdream/site-i18n/messages';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  metaLine?: string;
  signature?: string;
  localeHrefs?: Partial<Record<Locale, string>>;
  /**
   * Set when the entry for this locale does not exist and another locale's is
   * being shown instead. Surfaced to the reader rather than passed off as a
   * translation.
   */
  fallbackFrom?: string;
}

const rawLocale = Astro.props.locale ?? DEFAULT_LOCALE;
const locale: Locale = isLocale(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const { title, description, metaLine, signature, localeHrefs, fallbackFrom } =
  Astro.props as Props;

const messages = getMessages(locale);

/*
  Told in the reader's own language, naming the language they are about to read.
  A bare locale code in a warning box tells them nothing.
*/
const fallbackNotice = fallbackFrom
  ? messages.about.notTranslated.replace(
      '{lang}',
      ENABLED_LOCALE_LABELS[fallbackFrom] ?? fallbackFrom
    )
  : undefined;
---

<CyberdreamShell
  locale={locale}
  title={title}
  description={description}
  localeHrefs={localeHrefs}
  bodyClass="cd-page-about"
  ambient
>
  <article class="cd-article">
    <header class="cd-hero">
      {metaLine && <span class="cd-eyebrow">{metaLine}</span>}
      <h1 class="cd-hero__title">{title}</h1>
      <p class="cd-hero__lede">{description}</p>
    </header>

    {
      fallbackNotice && (
        <p class="cyber-alert cyber-alert--warning" role="note">
          {fallbackNotice}
        </p>
      )
    }

    <div class="cd-prose cd-about-body" lang={fallbackFrom ?? undefined}>
      <slot />

      {signature && <blockquote>{signature}</blockquote>}
    </div>

    <p class="cd-meta" style="margin-top: var(--space-lg);">
      <span>{SITE_AUTHOR}</span>
    </p>
  </article>
</CyberdreamShell>
